{
  "manifest_version": 3,
  "name": "Crivo — Leitor do Google Chat",
  "version": "1.0.0",
  "description": "Lê as respostas (CNPJ + APROVADO/REPROVADO) do Google Chat e manda pro Painel BKO comparar com o Crivo.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://cdbvevtsaorburbmogpk.supabase.co/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["leitor.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Leitor do Google Chat (Crivo)" }
}
