# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave "publishable" nova (Project Settings > API Keys), usada só pelas
# chamadas de Edge Functions (ex: trocar senha de BKO).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Usada apenas pelo script local de seed (npm run seed), nunca pelo frontend.
# NUNCA commitar este valor.
SUPABASE_SERVICE_ROLE_KEY=

# Bot de atendimento no WhatsApp (tela Automações). Endereço do
# whatsapp-bot/qr-server.js publicado (ex: no Render) e o segredo que ele
# confere no cabeçalho x-app-secret.
# ATENÇÃO: tudo que começa com VITE_ vai junto no site publicado e qualquer
# pessoa consegue ver abrindo o código da página. Não use aqui nada que
# precise ficar realmente secreto.
VITE_WHATSAPP_QR_URL=
VITE_WHATSAPP_APP_SECRET=
