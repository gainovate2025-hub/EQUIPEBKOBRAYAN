# Chave da Deepgram (transcrição de voz em tempo real) — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Chave da Groq (a IA que decide o que responder, camada grátis) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chave da ElevenLabs (voz da IA) — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Porta onde esse servidor escuta (a extensão conecta nela via WebSocket)
PORT=4001
